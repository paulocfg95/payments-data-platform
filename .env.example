# Copy this file to .env and change the values.
# These defaults are for local development only. Never commit .env.

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_DB_NAME=airflow

# Airflow UI port on your machine
AIRFLOW_PORT=8081

# Shared secret for Airflow components (any long random string)
AIRFLOW_JWT_SECRET=change_me_to_a_long_random_string

# Warehouse (PostgreSQL)
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me_warehouse
WAREHOUSE_DB=warehouse
WAREHOUSE_PORT=5433

# MinIO (local S3). Password needs at least 8 characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# Bronze layer storage.
# Local: S3_ENDPOINT_URL points to MinIO.
# AWS S3 (phase 3): leave S3_ENDPOINT_URL empty and use real AWS keys.
BRONZE_BUCKET=datalake
S3_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
